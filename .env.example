# Copy this file to .env and fill in a real key. .env is git-ignored.

# --- Agno model provider -----------------------------------------------------
# Only "openai" is wired up today (see app/agents/model.py).
AGNO_MODEL_PROVIDER=openai
# Default OpenAI model, override with any model name your key can use.
MODEL_NAME=gpt-4o-mini
# Your key. Never commit this file with a real value in it.
OPENAI_API_KEY=sk-replace-me
# Optional: for an OpenAI-compatible gateway, otherwise leave empty.
OPENAI_BASE_URL=

# --- Postgres ----------------------------------------------------------------
# Used both by the app and by the db service in docker-compose.yml.
POSTGRES_USER=agno
POSTGRES_PASSWORD=agno
POSTGRES_DB=agno
POSTGRES_HOST=localhost
# Host port Postgres is published on (container port is always 5432).
POSTGRES_PORT=5432

# Optional: a full SQLAlchemy URL instead of the POSTGRES_* parts above.
# DATABASE_URL=postgresql+psycopg://agno:agno@localhost:5432/agno
